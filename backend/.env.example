PORT=3000
# Postgres local (docker compose up -d db) o nativo
DATABASE_URL=postgres://jujuygo:jujuygo@localhost:5432/jujuygo
DATABASE_URL_TEST=postgres://jujuygo:jujuygo@localhost:5432/jujuygo_test

# Supabase Auth (login Google). anon key es publica por diseno.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LLM opcional para yapas (Google AI Studio, tier gratis — otro pool que Antigravity).
# Solo en backend, nunca en el frontend. Sin key, /api/yapa/redactar devuelve fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Origen permitido por CORS en produccion (separado por comas). '*' para dev.
CORS_ORIGIN=*
